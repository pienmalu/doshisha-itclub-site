---
import { gates } from '../data/site';
---

<section class="section gate" id="gate">
  <div class="shell">
    <div class="gate__head reveal">
      <p class="eyebrow">03 — NO GATE</p>
      <h2 class="headline gate__title"><span class="nb">入るための</span><span class="nb">条件は、ない。</span></h2>
    </div>

    <dl class="gate__list">
      {
        gates.map((g, i) => (
          <div class="gate__item reveal" style={`--reveal-delay:${i * 80}ms`}>
            <dt class="gate__subject">
              <span class="caption gate__index numeral">{String(i + 1).padStart(2, '0')}</span>
              {g.subject}
            </dt>
            <dd class="gate__verdict">{g.verdict}</dd>
            <dd class="gate__note">{g.body}</dd>
          </div>
        ))
      }
    </dl>

    <p class="kicker gate__kicker reveal">
      条件を設けないのは、伸びる人を先に見分けられないからだ。<br />
      入会時の経歴と、半年後に何をつくっているかは、ほとんど関係がない。
    </p>
  </div>
</section>

<style>
  .gate__title {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
    max-width: 20em;
  }

  .gate__list {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem) clamp(2rem, 1rem + 4vw, 5rem);
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .gate__subject {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    font-size: var(--text-nav-label);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    color: var(--color-ash-gray);
  }

  .gate__index {
    color: var(--color-electric-iris);
    letter-spacing: 0.16em;
  }

  .gate__verdict {
    margin: 0.9rem 0 0;
    font-size: var(--step-subheading);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .gate__note {
    margin: 0.9rem 0 0;
    color: var(--color-silver-mist);
    line-height: 1.85;
    max-width: 24em;
  }

  .gate__kicker {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    max-width: 30em;
  }

  @media (min-width: 720px) {
    .gate__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .gate__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .gate__kicker {
      margin-left: auto;
      text-align: right;
    }
  }
</style>
