---
import Logo from './Logo.astro';
import { brand, nav, links } from '../data/site';

const year = new Date().getFullYear();

// トップ以外のページからはアンカーだけでは飛べないので、パスを付ける
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const to = (hash: string) => (isHome ? hash : `/${hash}`);

const externals = [
  { label: 'X', href: links.x },
  { label: 'Discord', href: links.discord },
  { label: 'Mail', href: links.mail ? `mailto:${links.mail}` : '' },
].filter((item) => item.href.length > 0);
---

<footer class="footer">
  <div class="shell footer__inner">
    <div class="footer__brand">
      <Logo label={brand.mark} />
      <p class="footer__legal">
        {brand.nameJa}<br />
        <span class="muted">同志社大学公認団体 / 京都</span>
      </p>
    </div>

    <nav class="footer__nav" aria-label="フッター">
      <p class="caption footer__label">SITE</p>
      <ul>
        {nav.map((item) => <li><a class="footer__link" href={to(item.href)}>{item.label}</a></li>)}
        <li><a class="footer__link" href={to("#join")}>参加する</a></li>
      </ul>
    </nav>

    {
      externals.length > 0 && (
        <nav class="footer__nav" aria-label="外部リンク">
          <p class="caption footer__label">CONTACT</p>
          <ul>
            {externals.map((item) => (
              <li>
                <a class="footer__link" href={item.href} rel="noopener noreferrer" target="_blank">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <p class="footer__mark"><span class="nb">このサイトに</span><span class="nb">実名は</span><span class="nb">載っていない。</span></p>
  </div>

  <div class="shell footer__base">
    <p class="caption">© <span class="numeral">{year}</span> {brand.mark}</p>
    <p class="caption muted">
      同志社大学および学校法人同志社の公式サイトではない。学生団体が運営している。
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .footer__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .footer__legal {
    margin-top: 1.1rem;
    font-size: var(--text-nav-label);
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  .footer__label {
    letter-spacing: 0.2em;
    margin-bottom: 1.1rem;
  }

  .footer__nav ul {
    display: grid;
    gap: 0.7rem;
  }

  .footer__link {
    font-size: var(--text-nav-label);
    color: var(--color-ash-gray);
    letter-spacing: 0.06em;
    transition: color 0.3s ease;
  }

  .footer__link:hover {
    color: var(--color-bone-white);
  }

  .footer__mark {
    font-size: var(--step-subheading);
    line-height: 1.35;
    letter-spacing: -0.02em;
    font-weight: var(--font-weight-regular);
    max-width: 14em;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  @media (min-width: 900px) {
    .footer__inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 2fr) minmax(0, 2fr) minmax(0, 4fr);
      align-items: start;
    }

    .footer__mark {
      text-align: right;
      justify-self: end;
    }
  }
</style>
