---
import { marquee } from '../data/site';

// 端の継ぎ目が見えないよう、同じ列を2回並べて半分ずつ流す
const row = [...marquee, ...marquee, ...marquee];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track" data-marquee>
    {
      [0, 1].map(() => (
        <span class="marquee__row">
          {row.map((word, i) => (
            <span class:list={['marquee__word', i % 2 === 1 && 'is-outline']}>
              {word}
              <span class="marquee__sep">→</span>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
    /* 両端を溶かす */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee__row {
    display: flex;
    flex: none;
  }

  .marquee__word {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding-right: 0.35em;
    font-family: 'Inter', var(--font-ppneuemontreal);
    font-size: clamp(3.5rem, 2rem + 8vw, 10rem);
    font-weight: var(--font-weight-extralight);
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  /* 輪郭だけの語を交互に置き、塗りの語とのリズムを作る */
  .marquee__word.is-outline {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.5);
  }

  .marquee__sep {
    font-size: 0.5em;
    color: var(--color-electric-iris);
    -webkit-text-stroke: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      transform: none !important;
    }
  }
</style>
