---
import { joinSteps, links } from '../data/site';
---

<section class="section join" id="join">
  <div class="shell join__inner">
    <p class="eyebrow reveal">07 — JOIN</p>
    <h2 class="display join__title reveal" style="--reveal-delay:60ms">
      <span class="nb">名前のない</span><span class="nb">状態で、</span><br /><span class="nb"
        >来ればいい。</span
      >
    </h2>

    <ol class="join__steps">
      {
        joinSteps.map((step, i) => (
          <li class="join__step reveal" style={`--reveal-delay:${140 + i * 90}ms`}>
            <span class="join__n numeral">{step.n}</span>
            <h3 class="join__step-title">{step.title}</h3>
            <p class="join__step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="join__cta reveal" style="--reveal-delay:420ms">
      <a class="pill join__pill" href={links.join} rel="noopener">
        参加フォームを開く
        <span class="pill__arrow" aria-hidden="true">→</span>
      </a>
      <p class="join__note">通年で受け付けている。学期の途中でも構わない。</p>
    </div>
  </div>
</section>

<style>
  .join {
    position: relative;
    /* 主要な CTA の直後なので、下の余白はフッターまでの間だけに絞る */
    padding-bottom: clamp(4rem, 3rem + 4vw, 6rem);
  }

  .join__title {
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .join__steps {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .join__n {
    display: block;
    font-size: var(--text-caption);
    letter-spacing: 0.2em;
    color: var(--color-electric-iris);
  }

  .join__step-title {
    margin-top: 0.9rem;
    font-size: var(--text-heading-2xs);
    letter-spacing: var(--tracking-heading-2xs);
    line-height: 1.3;
  }

  .join__step-body {
    margin-top: 0.7rem;
    color: var(--color-silver-mist);
    line-height: 1.9;
    max-width: 22em;
  }

  .join__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }

  .join__pill {
    padding: 1.1rem 1.9rem;
  }

  .join__note {
    max-width: 24em;
    font-size: var(--text-nav-label);
    letter-spacing: 0.04em;
    line-height: 1.8;
    color: var(--color-ash-gray);
  }

  @media (min-width: 760px) {
    .join__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
