---
import QRCode from 'qrcode';
import { links } from '../data/site';

// 画面の大きい端末から来た人は、手元のスマホで読み取って LINE を開く
const qr = links.join
  ? await QRCode.toString(links.join, {
      type: 'svg',
      margin: 0,
      errorCorrectionLevel: 'M',
      color: { dark: '#ffffff', light: '#00000000' },
    })
  : '';
---

<section class="section join" id="join" aria-labelledby="join-title">
  <div class="field" aria-hidden="true">
    <canvas
      data-glyph-field
      data-glyphs="1"
      data-guard="#join-copy"
      data-seed="20260409"
      data-x="0.78"
      data-scale="0.62"
      data-y-narrow="0.3"
      data-scale-narrow="0.75"></canvas>
  </div>

  <div class="shell join__inner">
    <div class="join__copy" id="join-copy">
      <p class="label reveal"><span class="label__n">06</span>JOIN</p>
      <h2 class="display join__title" id="join-title">
        <span class="line reveal-line"><span>次の1を、</span></span>
        <span class="line reveal-line"><span>ここから。</span></span>
      </h2>
      <p class="lead join__lead reveal">
        入会はLINEのグループから。<span class="nb">質問だけでも構いません。</span>
      </p>

      <div class="join__actions reveal">
        {
          links.join && (
            <a class="pill pill--lg" href={links.join} target="_blank" rel="noopener" data-magnetic>
              LINEで参加する
              <span class="pill__arrow" aria-hidden="true">→</span>
            </a>
          )
        }
        {
          links.instagram && (
            <a class="ghost" href={links.instagram} target="_blank" rel="noopener">
              Instagramで活動を見る
            </a>
          )
        }
      </div>
      {
        qr && (
          <figure class="join__qr reveal">
            <div class="join__qr-code" set:html={qr} />
            <figcaption class="caption">スマートフォンで読み取ると、LINEのグループが開きます。</figcaption>
          </figure>
        )
      }
    </div>

  </div>
</section>

<style>
  .join {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 56rem);
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    display: grid;
    align-items: center;
  }

  .join__inner {
    position: relative;
  }

  .join__copy {
    max-width: 40rem;
  }

  .join__title {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .join__lead {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .join__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-24) var(--spacing-36);
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
  }

  .join__qr {
    display: none;
    align-items: center;
    gap: 1.25rem;
    margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) 0 0;
  }

  .join__qr-code {
    flex: none;
    width: 6.5rem;
    padding: 0.9rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .join__qr-code :global(svg) {
    width: 100%;
    height: auto;
  }

  .join__qr figcaption {
    max-width: 14em;
  }

  /* QR はポインタのある大きい画面だけ。スマホで見ている人には意味がない */
  @media (min-width: 1000px) and (pointer: fine) {
    .join__qr {
      display: flex;
    }
  }

  @media (max-width: 859px) {
    .join {
      align-items: end;
    }
  }
</style>
