---
import { links } from '../data/site';
---

<section class="hero" id="top" data-progress data-steps="2" aria-labelledby="hero-title">
  <div class="hero__sticky">
    <div class="field" aria-hidden="true">
      <canvas
        data-glyph-field
        data-glyphs="0,1"
        data-track=".hero"
        data-guard="#hero-copy"
        data-seed="20260401"
        data-x="0.73"
        data-scale="0.86"
        data-y-narrow="0.3"
        data-scale-narrow="0.78"></canvas>
    </div>

    <div class="hero__inner shell">
      <div class="hero__copy" id="hero-copy">
        <p class="label hero__eyebrow">同志社大学公認 / IT起業サークル</p>

        <h1 class="display hero__title" id="hero-title">
          <span class="line"><span>作って、</span></span>
          <span class="line"><span>売る。</span></span>
        </h1>

        <p class="lead hero__lead">
          <span class="nb">アイデアのままでは、0。</span><span class="nb">世に出して、はじめて1になる。</span><br />
          <span class="hero__sub"><span class="nb">学年・学部・プログラミング経験は問いません。</span><span class="nb">入会費は無料です。</span></span>
        </p>

        <div class="hero__actions">
          <a class="pill" href={links.join} target="_blank" rel="noopener" data-magnetic>
            LINEで参加する
            <span class="pill__arrow" aria-hidden="true">→</span>
          </a>
          <a class="ghost" href="#principles">考え方を読む</a>
        </div>
      </div>
    </div>

    <div class="hero__hud shell" aria-hidden="true">
      <span class="label hero__hud-from">IDEA <b>0</b></span>
      <span class="hero__bar"><span></span></span>
      <span class="label hero__hud-to">PRODUCT <b>1</b></span>
      <span class="label hero__hint">SCROLL</span>
    </div>
  </div>
</section>

<style>
  /* sticky の区間。スクロールの長さが 0 → 1 の変形の長さになる */
  .hero {
    position: relative;
    height: 240svh;
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 34rem;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    max-width: var(--page-max-width);
  }

  .hero__copy {
    max-width: min(40rem, 100%);
  }

  .hero__eyebrow {
    opacity: 0;
    animation: rise-in 1s var(--ease-out) 0.2s forwards;
  }

  .hero__title {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
    font-size: var(--step-hero);
    line-height: 1.02;
  }

  .hero__title .line:nth-child(1) > span {
    animation-delay: 0.3s;
  }

  .hero__title .line:nth-child(2) > span {
    animation-delay: 0.42s;
  }

  .hero__lead {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    max-width: 32em;
    opacity: 0;
    animation: rise-in 1.1s var(--ease-out) 0.75s forwards;
  }

  .hero__sub {
    display: inline-block;
    margin-top: 0.6em;
    color: var(--color-silver-mist);
    font-size: 0.9em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-24) var(--spacing-36);
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    opacity: 0;
    animation: rise-in 1.1s var(--ease-out) 0.9s forwards;
  }

  /* --- 0 → 1 の進み具合 ------------------------------------------------- */

  .hero__hud {
    position: absolute;
    inset: auto 0 clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    display: flex;
    align-items: center;
    gap: var(--spacing-18);
    opacity: 0;
    animation: rise-in 1s var(--ease-out) 1.2s forwards;
  }

  .hero__hud b {
    font-weight: var(--font-weight-regular);
    color: var(--color-bone-white);
  }

  .hero__hud-to {
    color: color-mix(in srgb, var(--color-ash-gray), var(--color-bone-white) calc(var(--p, 0) * 100%));
  }

  .hero__bar {
    position: relative;
    flex: 0 1 12rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }

  .hero__bar > span {
    position: absolute;
    inset: 0;
    background: var(--color-electric-iris);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  .hero__hint {
    margin-left: auto;
    transition: opacity 0.4s ease;
  }

  .hero[data-step='1'] .hero__hint {
    opacity: 0;
  }

  @media (max-width: 859px) {
    .hero {
      height: 200svh;
    }

    /* 狭い画面では、上に文字の形、下に見出しを置く */
    .hero__sticky {
      align-items: end;
      padding-bottom: clamp(5rem, 4rem + 4vw, 6.5rem);
    }

    .hero__hint {
      display: none;
    }
  }

  @media (max-height: 640px) and (max-width: 859px) {
    .hero__sub {
      display: none;
    }
  }
</style>
