---
import { ventures } from '../data/site';
---

<section class="section proof" id="proof">
  <div class="shell proof__grid">
    <div class="proof__head reveal">
      <p class="eyebrow">02 — PROOF</p>
      <h2 class="headline proof__title">作って、<br />その先へ。</h2>
      <p class="prose proof__note">
        同志社大学の公認団体として、学内の教室も使いながら活動している。メンバーが取り組んだものには、法人化や事業譲渡につながった例もある。
      </p>
    </div>

    <ol class="proof__list">
      {
        ventures.map((v, i) => (
          <li class="proof__item reveal" style={`--reveal-delay:${i * 90}ms`}>
            <span class="proof__id numeral">{v.id}</span>
            <div class="proof__row">
              <span class="caption proof__meta">
                <span class="numeral">{v.year}</span> / {v.tag}
              </span>
            </div>
            <h3 class="proof__name">{v.title}</h3>
            <p class="proof__desc">{v.body}</p>
          </li>
        ))
      }
    </ol>
  </div>

</section>

<style>
  .proof__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 6vw, 7rem);
  }

  .proof__title {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .proof__note {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    max-width: 30em;
  }

  .proof__list {
    display: grid;
    gap: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }

  .proof__item {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    grid-template-areas:
      'id row'
      '.  name'
      '.  desc';
    column-gap: 0.5rem;
  }

  .proof__id {
    grid-area: id;
    font-size: var(--text-caption);
    letter-spacing: 0.14em;
    color: var(--color-electric-iris);
    padding-top: 0.55rem;
  }

  .proof__row {
    grid-area: row;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .proof__meta {
    letter-spacing: 0.14em;
  }

  .proof__name {
    grid-area: name;
    margin-top: 0.85rem;
    font-size: var(--text-heading-2xs);
    letter-spacing: var(--tracking-heading-2xs);
    line-height: 1.35;
  }

  .proof__desc {
    grid-area: desc;
    margin-top: 0.6rem;
    color: var(--color-ash-gray);
    line-height: 1.85;
    max-width: 30em;
  }

  @media (min-width: 1000px) {
    /* 01 とは反転させて、読みのリズムをつくる */
    .proof__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }

    .proof__list {
      order: -1;
    }

    .proof__head {
      position: sticky;
      top: 8rem;
      order: 1;
    }
  }
</style>
