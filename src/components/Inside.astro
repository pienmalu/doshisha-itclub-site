---
import { activities, media } from '../data/site';
---

<section class="section inside" id="inside">
  <div class="shell inside__grid">
    <div class="inside__head reveal">
      <p class="eyebrow">05 — INSIDE</p>
      <h2 class="headline inside__title">毎週、<br />手を動かす。</h2>
      <figure class="inside__figure">
        <img
          src={media.inside.src}
          width={media.inside.width}
          height={media.inside.height}
          alt={media.inside.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="caption">{media.inside.caption}</figcaption>
      </figure>
    </div>

    <dl class="inside__list">
      {
        activities.map((a, i) => (
          <div class="inside__item reveal" style={`--reveal-delay:${i * 80}ms`}>
            <dt>
              <span class="caption inside__when">{a.when}</span>
              <span class="inside__name">{a.title}</span>
            </dt>
            <dd>{a.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .inside__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 5vw, 6rem);
  }

  .inside__title {
    margin-top: clamp(1rem, 0.75rem + 1vw, 1.75rem);
  }

  .inside__figure {
    margin: clamp(2rem, 1.5rem + 2vw, 3rem) 0 0;
  }

  .inside__figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-3xl);
  }

  .inside__figure figcaption {
    margin-top: 0.9rem;
    letter-spacing: 0.06em;
  }

  .inside__list {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2.5vw, 3.75rem);
  }

  .inside__item dt {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .inside__when {
    letter-spacing: 0.16em;
    color: var(--color-saffron-spark);
    /* 幅を固定して、右の見出しが縦に揃う */
    flex: 0 0 6.5rem;
  }

  .inside__name {
    font-size: var(--text-heading-2xs);
    letter-spacing: var(--tracking-heading-2xs);
    line-height: 1.3;
  }

  .inside__item dd {
    margin: 0.7rem 0 0;
    color: var(--color-silver-mist);
    line-height: 1.9;
    max-width: 32em;
  }

  @media (min-width: 1000px) {
    /* 04 は見出しを左に置いたので、ここは右へ */
    .inside__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }

    .inside__list {
      order: -1;
      padding-top: 0.6rem;
    }

    .inside__item dd {
      padding-left: 7.5rem;
      max-width: 28em;
    }
  }

  @media (max-width: 999px) {
    .inside__when {
      flex-basis: auto;
    }
  }
</style>
